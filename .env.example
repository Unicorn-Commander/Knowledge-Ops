# Safe local defaults for the standalone compose.
# This file contains names and non-secret values only. Copy selected lines to a
# host-only .env; never commit a filled .env or put bearer credentials here.

KNOWLEDGE_OPS_DATA=/data
KNOWLEDGE_OPS_DB=/data/knowledge_ops.sqlite3
KNOWLEDGE_OPS_WIKI=/wiki
KNOWLEDGE_OPS_OPENWIKI_STAGING=/data/openwiki/staging

# Keep the standalone image-baked corpus disabled.
KNOWLEDGE_OPS_SEED_INTERNAL_CORPUS=0

# The compose-local bootstrap issuer is the default signer for this loopback
# stack. Replace all issuer/JWKS values together for another deployment.
KNOWLEDGE_OPS_API_REQUIRE_AUTH=1
KNOWLEDGE_OPS_API_AUDIENCE=knowledge-ops
KNOWLEDGE_OPS_API_DEFAULT_OIDC_SCOPES=read:knowledge
KNOWLEDGE_OPS_API_OIDC_JWKS_URL=http://knowledge-ops-auth:8766/.well-known/jwks.json
KNOWLEDGE_OPS_API_TRUSTED_ISSUERS=http://knowledge-ops-auth:8766

KNOWLEDGE_OPS_MCP_JWKS_URL=http://knowledge-ops-auth:8766/.well-known/jwks.json
KNOWLEDGE_OPS_MCP_AUDIENCE=knowledge-ops
KNOWLEDGE_OPS_MCP_TRUSTED_ISSUERS=http://knowledge-ops-auth:8766

# Optional live stores are off for a fresh host.
KNOWLEDGE_OPS_ENABLE_QDRANT=0
KNOWLEDGE_OPS_ENABLE_FALKORDB=0
KNOWLEDGE_OPS_ENABLE_CENTER_DEEP=0
KNOWLEDGE_OPS_REQUIRE_WORKER=0
